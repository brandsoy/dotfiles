#!/usr/bin/env bash
set -euo pipefail

command -v fzf >/dev/null || {
    echo "herdr-agent-picker requires fzf" >&2
    exit 1
}
command -v jq >/dev/null || {
    echo "herdr-agent-picker requires jq" >&2
    exit 1
}

agents="$(herdr agent list)"
width="$(tput cols 2>/dev/null || echo 80)"
title_width=$((width - 27))
((title_width < 12)) && title_width=12
printf -v header "%-*s  %-10s  %-8s" "$title_width" SPACE AGENT STATUS
selected="$(jq -r '
  .result.agents[]? |
  [.pane_id, .agent,
   (if .agent_status == "working" then "WORKING"
    elif .agent_status == "blocked" then "BLOCKED"
    elif .agent_status == "done" then "DONE"
    else "IDLE" end),
   ((.terminal_title_stripped // .cwd // "")
     | sub("^(OC|π) (\\| |[-–] )"; ""))] |
  @tsv
' <<<"$agents" | awk -F '\t' -v title_width="$title_width" 'BEGIN { OFS = "\t" }
  { printf "%s\t%-*.*s  %-10.10s  %-8.8s\n", $1, title_width, title_width, $4, $2, $3 }
' | fzf \
    --delimiter=$'\t' \
    --with-nth=2 \
    --prompt='› ' \
    --header="$header" \
    --footer='Enter focus  ·  Esc close' \
    --no-info \
    --no-border \
    --height=100% \
    --padding=1,2 \
    --layout=reverse \
    --color='bg:-1,bg+:-1,fg:7,fg+:15,hl:4,hl+:4,prompt:6,pointer:5,marker:2,header:7')" || exit 0

pane_id="${selected%%$'\t'*}"
[[ -n "$pane_id" ]] && herdr agent focus "$pane_id"
