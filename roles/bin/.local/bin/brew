#!/usr/bin/env bash
set -euo pipefail

resolve_script_path() {
  local source_path="$1"
  while [[ -L "$source_path" ]]; do
    local dir
    dir="$(cd "$(dirname "$source_path")" && pwd)"
    source_path="$(readlink "$source_path")"
    [[ "$source_path" != /* ]] && source_path="$dir/$source_path"
  done
  cd "$(dirname "$source_path")" && pwd -P
}

find_real_brew() {
  local self_dir
  self_dir="$(resolve_script_path "${BASH_SOURCE[0]}")"

  local path_entry candidate
  IFS=':' read -r -a path_entries <<< "$PATH"
  for path_entry in "${path_entries[@]}"; do
    [[ -n "$path_entry" ]] || continue
    if [[ "$(cd "$path_entry" 2>/dev/null && pwd -P)" == "$self_dir" ]]; then
      continue
    fi
    candidate="$path_entry/brew"
    if [[ -x "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

sync_brewfile() {
  local dotfiles_dir="${DOTFILES_DIR:-$HOME/dotfiles}"
  local brewfile="$dotfiles_dir/roles/packages-macos/Brewfile"
  local legacy_brewfile="$dotfiles_dir/homebrew/Brewfile"

  if [[ -f "$brewfile" ]]; then
    "$REAL_BREW" bundle dump --force --file="$brewfile" >/dev/null
  elif [[ -f "$legacy_brewfile" ]]; then
    "$REAL_BREW" bundle dump --force --file="$legacy_brewfile" >/dev/null
  fi
}

REAL_BREW="$(find_real_brew)" || {
  echo "brew shim: could not find real Homebrew binary in PATH" >&2
  exit 1
}

subcommand="${1:-}"
sync_needed=0
case "$subcommand" in
  install|uninstall|remove|tap|untap)
    sync_needed=1
    ;;
esac

"$REAL_BREW" "$@"
exit_status=$?

if [[ $exit_status -eq 0 && $sync_needed -eq 1 ]]; then
  sync_brewfile
fi

exit $exit_status
