// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "vim_mode": true,
  "terminal": {
    "font_family": "Maple Mono NF"
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry",
    },
    "opencode": {
      "default_config_options": {
        "effort": "medium",
        "mode": "build",
        "model": "github-copilot/gpt-5.3-codex"
      },
      "type": "registry",
    },
  },
  "project_panel": {
    "hide_hidden": false,
    "dock": "right",
    "hide_gitignore": true,
  },
  "file_scan_exclusions": [
    "**/bin/**",
    "**/obj/**",
    "**/git/**",
    "**/node_modules/**",
  ],
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "relative_line_numbers": "enabled",
  "agent": {
    "dock": "left",
    "default_model": {
      "provider": "openai",
      "model": "gpt-5.5",
      "enable_thinking": false,
    },
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "gpt-5.4",
        "enable_thinking": false,
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-5.3-codex",
        "enable_thinking": false,
      },
    ],
    "model_parameters": [],
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "copilot",
  },
  "ui_font_size": 16,
  "buffer_font_family": "Maple Mono NF",
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
    "languages": {
            "TypeScript": {
                "language_servers": [
                    "typescript-ls",
                    "!vtsls",
                    "!typescript-language-server",
                ],
            },
            "TSX": {
                "language_servers": [
                    "typescript-ls",
                    "!vtsls",
                    "!typescript-language-server",
                ],
            },
        },
}
