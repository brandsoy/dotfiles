// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent": {
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "model": "openai/gpt-5.6-luna"
      },
      "favorite_config_option_values": {
        "model": [
          "openai/gpt-5.6-luna",
          "openai/gpt-5.6-terra"
        ]
      },
      "type": "registry"
    }
  },
  "cli_default_open_behavior": "existing_window",
  "vim_mode": true,
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font"
  },
  "project_panel": {
    "hide_hidden": false,
    "dock": "right",
    "hide_gitignore": true,
  },
  "file_scan_exclusions": [
    "**/bin/**",
    "**/obj/**",
    "**/git/**",
    "**/node_modules/**",
  ],
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
    "tree_view": true,
  },
  "relative_line_numbers": "enabled",
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "copilot",
  },
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Macchiato - No Italics",
  },
  "format_on_save": "on",
  "languages": {
      "Go": {
        "language_servers": ["gopls", "!..."],
        "formatter": {
          "language_server": {
            "name": "gopls"
          }
        }
      },
      "Svelte": {
        "language_servers": ["svelte-language-server", "!..."],
        "formatter": {
          "language_server": {
            "name": "svelte-language-server"
          }
        }
      },
      "TypeScript": {
        "language_servers": ["biome", "typescript-language-server", "!..."],
        "formatter": {
          "language_server": {
            "name": "biome"
          }
        }
      },
      "JavaScript": {
        "language_servers": ["biome", "typescript-language-server", "!..."],
        "formatter": {
          "language_server": {
            "name": "biome"
          }
        }
      },
      "JSON": {
        "language_servers": ["biome", "!..."],
        "formatter": {
          "language_server": {
            "name": "biome"
          }
        }
      },
      "JSONC": {
        "language_servers": ["biome", "!..."],
        "formatter": {
          "language_server": {
            "name": "biome"
          }
        }
      }
    },

    "lsp": {
      "gopls": {
        "initialization_options": {
          "gofumpt": true,
          "analyses": {
            "unusedparams": true,
            "shadow": true
          }
        }
      },
      "biome": {
        "settings": {
          "require_config_file": true
        }
      }
    }
}
