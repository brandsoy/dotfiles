{
  "palette": {
    "background": "#faf4ed",
    "foreground": "#575279",
    "black": "#1f252d",
    "red": "#b4637a",
    "green": "#6d8f89",
    "yellow": "#ea9d34",
    "blue": "#0350ae",
    "magenta": "#907aa9",
    "cyan": "#56949f",
    "white": "#908caa",
    "bright_black": "#55667b",
    "bright_red": "#d76186",
    "bright_green": "#64a097",
    "bright_yellow": "#ffa821",
    "bright_blue": "#005bc6",
    "bright_magenta": "#a481c8",
    "bright_cyan": "#3ea5b4",
    "selection": "#dfdad9",
    "active_tab_background": "#e2dcdc",
    "inactive_tab_foreground": "#67637d",
    "main_bg": "#ffffff",
    "main_fg": "#2b343f",
    "selected_bg": "#cddcef",
    "inactive_fg": "#70818f",
    "proc_misc": "#a268f6",
    "temp_start": "#0c9671",
    "temp_mid": "#04baba",
    "temp_end": "#d73a49",
    "used_mid": "#c48200"
  },
  "mappings": {
    "GHOSTTY_THEME": "github_monochrome_rosepine-dawn",
    "NVIM_THEME": "github-monochrome-rosepine-dawn",
    "BAT_THEME": ""
  },
  "files": {
    "btop.theme": {
      "template": "btop/default.theme",
      "values": {
        "main_bg": "@main_bg",
        "main_fg": "@main_fg",
        "title": "@main_fg",
        "hi_fg": "@blue",
        "selected_bg": "@selected_bg",
        "selected_fg": "@main_fg",
        "inactive_fg": "@inactive_fg",
        "proc_misc": "@proc_misc",
        "cpu_box": "@inactive_fg",
        "mem_box": "@inactive_fg",
        "net_box": "@inactive_fg",
        "proc_box": "@inactive_fg",
        "div_line": "@inactive_fg",
        "temp_start": "@temp_start",
        "temp_mid": "@temp_mid",
        "temp_end": "@temp_end",
        "cpu_start": "@temp_start",
        "cpu_mid": "@temp_mid",
        "cpu_end": "@temp_end",
        "free_start": "@temp_start",
        "free_mid": "@temp_mid",
        "free_end": "@temp_end",
        "cached_start": "@blue",
        "cached_mid": "@proc_misc",
        "cached_end": "@temp_end",
        "available_start": "@temp_start",
        "available_mid": "@temp_mid",
        "available_end": "@blue",
        "used_start": "@temp_end",
        "used_mid": "@used_mid",
        "used_end": "@proc_misc",
        "download_start": "@blue",
        "download_mid": "@temp_mid",
        "download_end": "@proc_misc",
        "upload_start": "@temp_start",
        "upload_mid": "@used_mid",
        "upload_end": "@temp_end"
      }
    },
    "fzf.sh": {
      "template": "fzf/github-monochrome-dark.sh",
      "values": {
        "fzf_bg_plus": "@selected_bg",
        "fzf_bg": "@main_bg",
        "fzf_border": "@inactive_fg",
        "fzf_fg": "@main_fg",
        "fzf_gutter": "@main_bg",
        "fzf_hl_plus": "@blue",
        "fzf_hl": "@blue",
        "fzf_info": "@inactive_fg",
        "fzf_marker": "@proc_misc",
        "fzf_pointer": "@proc_misc",
        "fzf_prompt": "@temp_start",
        "fzf_query": "@main_fg",
        "fzf_scrollbar": "@inactive_fg",
        "fzf_separator": "@proc_misc",
        "fzf_spinner": "@proc_misc"
      }
    },
    "ghostty": {
      "template": "ghostty/github-monochrome-dark.conf",
      "values": {
        "background": "@background",
        "color0": "@black",
        "color1": "@red",
        "color10": "@bright_green",
        "color11": "@bright_yellow",
        "color12": "@bright_blue",
        "color13": "@bright_magenta",
        "color14": "@bright_cyan",
        "color15": "@foreground",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@white",
        "color8": "@bright_black",
        "color9": "@bright_red",
        "cursor_color": "@foreground",
        "foreground": "@foreground",
        "selection_background": "@selection",
        "selection_foreground": "@foreground"
      }
    },
    "kitty.conf": {
      "template": "kitty/github-monochrome-dark.conf",
      "values": {
        "active_tab_background": "@active_tab_background",
        "active_tab_foreground": "@white",
        "background": "@background",
        "color0": "@black",
        "color1": "@red",
        "color10": "@bright_green",
        "color11": "@bright_yellow",
        "color12": "@bright_blue",
        "color13": "@bright_magenta",
        "color14": "@bright_cyan",
        "color15": "@foreground",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@white",
        "color8": "@bright_black",
        "color9": "@bright_red",
        "cursor": "@foreground",
        "foreground": "@foreground",
        "inactive_tab_background": "@background",
        "inactive_tab_foreground": "@inactive_tab_foreground",
        "selection_background": "@selection",
        "selection_foreground": "@foreground",
        "tab_bar_background": "none"
      }
    },
    "lazygit.yml": {
      "template": "lazygit/github-monochrome-dark.yml",
      "values": {
        "activeBorderColor": "@blue",
        "inactiveBorderColor": "@white",
        "searchingActiveBorderColor": "@cyan",
        "optionsTextColor": "@blue",
        "selectedLineBgColor": "@bright_black",
        "inactiveViewSelectedLineBgColor": "@bright_black",
        "cherryPickedCommitFgColor": "@foreground",
        "cherryPickedCommitBgColor": "@magenta",
        "markedBaseCommitFgColor": "@foreground",
        "markedBaseCommitBgColor": "@yellow",
        "unstagedChangesColor": "@red",
        "defaultFgColor": "@foreground"
      }
    },
    "starship.toml": {
      "template": "starship/github-monochrome-dark.toml",
      "values": {
        "git_status_ahead": "@blue",
        "git_status_behind": "@blue",
        "git_status_diverged": "@blue",
        "git_status_staged": "@green",
        "git_status_modified": "@yellow",
        "git_status_untracked": "@foreground",
        "git_status_deleted": "@red",
        "git_status_conflicted": "@red"
      }
    },
    "tmux.theme.conf": {
      "template": "tmux/default.conf",
      "values": {
        "bg": "@background",
        "active": "@blue",
        "inactive": "@white",
        "text": "@foreground",
        "accent": "@magenta",
        "border": "@bright_black"
      }
    }
  }
}
