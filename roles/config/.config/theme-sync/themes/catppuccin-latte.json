{
  "palette": {
    "background": "#eff1f5",
    "foreground": "#4c4f69",
    "black": "#5c5f77",
    "red": "#d20f39",
    "green": "#40a02b",
    "yellow": "#df8e1d",
    "blue": "#1e66f5",
    "magenta": "#ea76cb",
    "cyan": "#179299",
    "white": "#acb0be",
    "bright_black": "#6c6f85",
    "bright_white": "#9ca0b0",
    "selection": "#dc8a78",
    "active_border_color": "#7287fd",
    "active_tab_background": "#8839ef",
    "inactive_tab_background": "#e6e9ef",
    "mark3_background": "#04a5e5",
    "scrollbar_handle_color": "#8c8fa1",
    "tab_bar_background": "#dce0e8",
    "selected_bg": "#bcc0cc",
    "net_box": "#e64553",
    "available_start": "#fe640b",
    "fzf_bg_plus": "#ccd0da"
  },
  "mappings": {
    "GHOSTTY_THEME": "catppuccin-latte",
    "NVIM_THEME": "catppuccin-latte",
    "BAT_THEME": "Catppuccin Latte",
    "VSCODE_THEME": "Catppuccin Latte"
  },
  "files": {
    "btop.theme": {
      "template": "btop/catppuccin-latte.theme",
      "values": {
        "main_bg": "@background",
        "main_fg": "@foreground",
        "title": "@foreground",
        "hi_fg": "@blue",
        "selected_bg": "@selected_bg",
        "selected_fg": "@blue",
        "inactive_fg": "@scrollbar_handle_color",
        "graph_text": "@selection",
        "meter_bg": "@selected_bg",
        "proc_misc": "@selection",
        "cpu_box": "@active_tab_background",
        "mem_box": "@green",
        "net_box": "@net_box",
        "proc_box": "@blue",
        "div_line": "@bright_white",
        "temp_start": "@green",
        "temp_mid": "@yellow",
        "temp_end": "@red",
        "cpu_start": "@cyan",
        "cpu_mid": "@mark3_background",
        "cpu_end": "@active_border_color",
        "free_start": "@active_tab_background",
        "free_mid": "@active_border_color",
        "free_end": "@blue",
        "cached_start": "@mark3_background",
        "cached_mid": "@blue",
        "cached_end": "@active_border_color",
        "available_start": "@available_start",
        "available_mid": "@net_box",
        "available_end": "@red",
        "used_start": "@green",
        "used_mid": "@cyan",
        "used_end": "@mark3_background",
        "download_start": "@available_start",
        "download_mid": "@net_box",
        "download_end": "@red",
        "upload_start": "@green",
        "upload_mid": "@cyan",
        "upload_end": "@mark3_background",
        "process_start": "@mark3_background",
        "process_mid": "@active_border_color",
        "process_end": "@active_tab_background"
      }
    },
    "fzf.sh": {
      "template": "fzf/carbonfox.sh",
      "values": {
        "fzf_bg_plus": "@fzf_bg_plus",
        "fzf_bg": "@background",
        "fzf_border": "@bright_white",
        "fzf_fg": "@foreground",
        "fzf_gutter": "@background",
        "fzf_header": "@red",
        "fzf_hl_plus": "@red",
        "fzf_hl": "@red",
        "fzf_info": "@active_tab_background",
        "fzf_marker": "@active_border_color",
        "fzf_pointer": "@selection",
        "fzf_prompt": "@active_tab_background",
        "fzf_query": "@foreground",
        "fzf_scrollbar": "@bright_white",
        "fzf_separator": "@red",
        "fzf_spinner": "@selection"
      }
    },
    "kitty.conf": {
      "template": "kitty/catppuccin-latte.conf",
      "values": {
        "active_border_color": "@active_border_color",
        "active_tab_background": "@active_tab_background",
        "active_tab_foreground": "@background",
        "background": "@background",
        "bell_border_color": "@yellow",
        "color0": "@black",
        "color1": "@red",
        "color10": "@green",
        "color11": "@yellow",
        "color12": "@blue",
        "color13": "@magenta",
        "color14": "@cyan",
        "color15": "@bright_white",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@white",
        "color8": "@bright_black",
        "color9": "@red",
        "cursor": "@selection",
        "cursor_text_color": "@background",
        "foreground": "@foreground",
        "inactive_border_color": "@bright_white",
        "inactive_tab_background": "@inactive_tab_background",
        "inactive_tab_foreground": "@foreground",
        "macos_titlebar_color": "system",
        "mark1_background": "@active_border_color",
        "mark1_foreground": "@background",
        "mark2_background": "@active_tab_background",
        "mark2_foreground": "@background",
        "mark3_background": "@mark3_background",
        "mark3_foreground": "@background",
        "scrollbar_handle_color": "@scrollbar_handle_color",
        "scrollbar_track_color": "@black",
        "selection_background": "@selection",
        "selection_foreground": "@background",
        "tab_bar_background": "@tab_bar_background",
        "url_color": "@selection",
        "wayland_titlebar_color": "system"
      }
    },
    "tmux.theme.conf": {
      "template": "tmux/default.conf",
      "values": {
        "bg": "@background",
        "active": "@blue",
        "inactive": "@scrollbar_handle_color",
        "text": "@foreground",
        "accent": "@blue",
        "border": "@selected_bg"
      }
    },
    "ghostty": {
      "template": "ghostty/terminal.conf",
      "values": {
        "foreground": "@foreground",
        "background": "@background",
        "cursor": "@selection",
        "selection_foreground": "@background",
        "selection_background": "@selection",
        "color0": "@black",
        "color1": "@red",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@white",
        "color8": "@bright_black",
        "color9": "@red",
        "color10": "@green",
        "color11": "@yellow",
        "color12": "@blue",
        "color13": "@magenta",
        "color14": "@cyan",
        "color15": "@bright_white"
      }
    }
  }
}
