{
  "palette": {
    "background": "#1e1e2e",
    "foreground": "#cdd6f4",
    "black": "#45475a",
    "red": "#f38ba8",
    "green": "#a6e3a1",
    "yellow": "#f9e2af",
    "blue": "#89b4fa",
    "magenta": "#f5c2e7",
    "cyan": "#94e2d5",
    "white": "#bac2de",
    "bright_black": "#585b70",
    "bright_white": "#a6adc8",
    "selection": "#f5e0dc",
    "active_border_color": "#b4befe",
    "active_tab_background": "#cba6f7",
    "active_tab_foreground": "#11111b",
    "inactive_border_color": "#6c7086",
    "inactive_tab_background": "#181825",
    "mark3_background": "#74c7ec",
    "scrollbar_handle_color": "#9399b2",
    "inactive_fg": "#7f849c",
    "net_box": "#eba0ac",
    "available_start": "#fab387",
    "used_end": "#89dceb",
    "fzf_bg_plus": "#313244"
  },
  "mappings": {
    "GHOSTTY_THEME": "catppuccin-mocha",
    "NVIM_THEME": "catppuccin-mocha",
    "BAT_THEME": "Catppuccin Mocha",
    "VSCODE_THEME": "Catppuccin Mocha"
  },
  "files": {
    "btop.theme": {
      "template": "btop/catppuccin-latte.theme",
      "values": {
        "main_bg": "@background",
        "main_fg": "@foreground",
        "title": "@foreground",
        "hi_fg": "@blue",
        "selected_bg": "@black",
        "selected_fg": "@blue",
        "inactive_fg": "@inactive_fg",
        "graph_text": "@selection",
        "meter_bg": "@black",
        "proc_misc": "@selection",
        "cpu_box": "@active_tab_background",
        "mem_box": "@green",
        "net_box": "@net_box",
        "proc_box": "@blue",
        "div_line": "@inactive_border_color",
        "temp_start": "@green",
        "temp_mid": "@yellow",
        "temp_end": "@red",
        "cpu_start": "@cyan",
        "cpu_mid": "@mark3_background",
        "cpu_end": "@active_border_color",
        "free_start": "@active_tab_background",
        "free_mid": "@active_border_color",
        "free_end": "@blue",
        "cached_start": "@mark3_background",
        "cached_mid": "@blue",
        "cached_end": "@active_border_color",
        "available_start": "@available_start",
        "available_mid": "@net_box",
        "available_end": "@red",
        "used_start": "@green",
        "used_mid": "@cyan",
        "used_end": "@used_end",
        "download_start": "@available_start",
        "download_mid": "@net_box",
        "download_end": "@red",
        "upload_start": "@green",
        "upload_mid": "@cyan",
        "upload_end": "@used_end",
        "process_start": "@mark3_background",
        "process_mid": "@active_border_color",
        "process_end": "@active_tab_background"
      }
    },
    "fzf.sh": {
      "template": "fzf/carbonfox.sh",
      "values": {
        "fzf_bg_plus": "@fzf_bg_plus",
        "fzf_bg": "@background",
        "fzf_border": "@inactive_border_color",
        "fzf_fg": "@foreground",
        "fzf_gutter": "@background",
        "fzf_header": "@red",
        "fzf_hl_plus": "@red",
        "fzf_hl": "@red",
        "fzf_info": "@active_tab_background",
        "fzf_marker": "@active_border_color",
        "fzf_pointer": "@selection",
        "fzf_prompt": "@active_tab_background",
        "fzf_query": "@foreground",
        "fzf_scrollbar": "@inactive_border_color",
        "fzf_separator": "@red",
        "fzf_spinner": "@selection"
      }
    },
    "kitty.conf": {
      "template": "kitty/catppuccin-latte.conf",
      "values": {
        "active_border_color": "@active_border_color",
        "active_tab_background": "@active_tab_background",
        "active_tab_foreground": "@active_tab_foreground",
        "background": "@background",
        "bell_border_color": "@yellow",
        "color0": "@black",
        "color1": "@red",
        "color10": "@green",
        "color11": "@yellow",
        "color12": "@blue",
        "color13": "@magenta",
        "color14": "@cyan",
        "color15": "@bright_white",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@white",
        "color8": "@bright_black",
        "color9": "@red",
        "cursor": "@selection",
        "cursor_text_color": "@background",
        "foreground": "@foreground",
        "inactive_border_color": "@inactive_border_color",
        "inactive_tab_background": "@inactive_tab_background",
        "inactive_tab_foreground": "@foreground",
        "macos_titlebar_color": "system",
        "mark1_background": "@active_border_color",
        "mark1_foreground": "@background",
        "mark2_background": "@active_tab_background",
        "mark2_foreground": "@background",
        "mark3_background": "@mark3_background",
        "mark3_foreground": "@background",
        "scrollbar_handle_color": "@scrollbar_handle_color",
        "scrollbar_track_color": "@black",
        "selection_background": "@selection",
        "selection_foreground": "@background",
        "tab_bar_background": "@active_tab_foreground",
        "url_color": "@selection",
        "wayland_titlebar_color": "system"
      }
    },
    "ghostty": {
      "template": "ghostty/terminal.conf",
      "values": {
        "foreground": "@foreground",
        "background": "@background",
        "cursor": "@selection",
        "selection_foreground": "@background",
        "selection_background": "@selection",
        "color0": "@black",
        "color1": "@red",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@white",
        "color8": "@bright_black",
        "color9": "@red",
        "color10": "@green",
        "color11": "@yellow",
        "color12": "@blue",
        "color13": "@magenta",
        "color14": "@cyan",
        "color15": "@bright_white"
      }
    },
    "tmux.theme.conf": {
      "template": "tmux/default.conf",
      "values": {
        "bg": "@background",
        "active": "@blue",
        "inactive": "@bright_black",
        "text": "@foreground",
        "accent": "@magenta",
        "border": "@selection"
      }
    }
  }
}
