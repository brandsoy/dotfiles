{
  "palette": {
    "background": "#002b36",
    "foreground": "#839496",
    "black": "#002731",
    "red": "#dc322f",
    "green": "#859900",
    "yellow": "#b58900",
    "blue": "#268bd2",
    "magenta": "#d33682",
    "cyan": "#2aa198",
    "white": "#657b83",
    "bright_black": "#073642",
    "bright_red": "#ff1b12",
    "bright_green": "#91a700",
    "bright_yellow": "#c59600",
    "bright_blue": "#0099eb",
    "bright_magenta": "#fb0093",
    "bright_cyan": "#00b1a6",
    "cursor": "#d30102",
    "active_tab_background": "#143b44",
    "inactive_tab_foreground": "#46585e",
    "main_bg": "#0d1117",
    "main_fg": "#c8d3f5",
    "hi_fg": "#79c0ff",
    "selected_bg": "#2a384b",
    "inactive_fg": "#8a92b2",
    "proc_misc": "#b691fa",
    "cpu_box": "#3e526f",
    "temp_start": "#9ece6a",
    "temp_mid": "#78dce8",
    "temp_end": "#ff7b72",
    "used_mid": "#f5b600"
  },
  "mappings": {
    "GHOSTTY_THEME": "github_monochrome_solarized",
    "NVIM_THEME": "github-monochrome-solarized",
    "BAT_THEME": ""
  },
  "files": {
    "btop.theme": {
      "template": "btop/default.theme",
      "values": {
        "main_bg": "@main_bg",
        "main_fg": "@main_fg",
        "title": "@main_fg",
        "hi_fg": "@hi_fg",
        "selected_bg": "@selected_bg",
        "selected_fg": "@main_fg",
        "inactive_fg": "@inactive_fg",
        "proc_misc": "@proc_misc",
        "cpu_box": "@cpu_box",
        "mem_box": "@cpu_box",
        "net_box": "@cpu_box",
        "proc_box": "@cpu_box",
        "div_line": "@cpu_box",
        "temp_start": "@temp_start",
        "temp_mid": "@temp_mid",
        "temp_end": "@temp_end",
        "cpu_start": "@temp_start",
        "cpu_mid": "@temp_mid",
        "cpu_end": "@temp_end",
        "free_start": "@temp_start",
        "free_mid": "@temp_mid",
        "free_end": "@temp_end",
        "cached_start": "@hi_fg",
        "cached_mid": "@proc_misc",
        "cached_end": "@temp_end",
        "available_start": "@temp_start",
        "available_mid": "@temp_mid",
        "available_end": "@hi_fg",
        "used_start": "@temp_end",
        "used_mid": "@used_mid",
        "used_end": "@proc_misc",
        "download_start": "@hi_fg",
        "download_mid": "@temp_mid",
        "download_end": "@proc_misc",
        "upload_start": "@temp_start",
        "upload_mid": "@used_mid",
        "upload_end": "@temp_end"
      }
    },
    "fzf.sh": {
      "template": "fzf/github-monochrome-dark.sh",
      "values": {
        "fzf_bg_plus": "@selected_bg",
        "fzf_bg": "@main_bg",
        "fzf_border": "@cpu_box",
        "fzf_fg": "@main_fg",
        "fzf_gutter": "@main_bg",
        "fzf_hl_plus": "@hi_fg",
        "fzf_hl": "@hi_fg",
        "fzf_info": "@inactive_fg",
        "fzf_marker": "@proc_misc",
        "fzf_pointer": "@proc_misc",
        "fzf_prompt": "@temp_start",
        "fzf_query": "@main_fg",
        "fzf_scrollbar": "@cpu_box",
        "fzf_separator": "@proc_misc",
        "fzf_spinner": "@proc_misc"
      }
    },
    "ghostty": {
      "template": "ghostty/github-monochrome-dark.conf",
      "values": {
        "background": "@background",
        "color0": "@black",
        "color1": "@red",
        "color10": "@bright_green",
        "color11": "@bright_yellow",
        "color12": "@bright_blue",
        "color13": "@bright_magenta",
        "color14": "@bright_cyan",
        "color15": "@foreground",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@white",
        "color8": "@bright_black",
        "color9": "@bright_red",
        "cursor_color": "@cursor",
        "foreground": "@foreground",
        "selection_background": "@bright_black",
        "selection_foreground": "@foreground"
      }
    },
    "kitty.conf": {
      "template": "kitty/github-monochrome-dark.conf",
      "values": {
        "active_tab_background": "@active_tab_background",
        "active_tab_foreground": "@white",
        "background": "@background",
        "color0": "@black",
        "color1": "@red",
        "color10": "@bright_green",
        "color11": "@bright_yellow",
        "color12": "@bright_blue",
        "color13": "@bright_magenta",
        "color14": "@bright_cyan",
        "color15": "@foreground",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@white",
        "color8": "@bright_black",
        "color9": "@bright_red",
        "cursor": "@cursor",
        "foreground": "@foreground",
        "inactive_tab_background": "@background",
        "inactive_tab_foreground": "@inactive_tab_foreground",
        "selection_background": "@bright_black",
        "selection_foreground": "@foreground",
        "tab_bar_background": "none"
      }
    },
    "lazygit.yml": {
      "template": "lazygit/github-monochrome-dark.yml",
      "values": {
        "activeBorderColor": "@blue",
        "inactiveBorderColor": "@white",
        "searchingActiveBorderColor": "@cyan",
        "optionsTextColor": "@blue",
        "selectedLineBgColor": "@bright_black",
        "inactiveViewSelectedLineBgColor": "@bright_black",
        "cherryPickedCommitFgColor": "@foreground",
        "cherryPickedCommitBgColor": "@magenta",
        "markedBaseCommitFgColor": "@foreground",
        "markedBaseCommitBgColor": "@yellow",
        "unstagedChangesColor": "@red",
        "defaultFgColor": "@foreground"
      }
    },
    "starship.toml": {
      "template": "starship/github-monochrome-dark.toml",
      "values": {
        "git_status_ahead": "@blue",
        "git_status_behind": "@blue",
        "git_status_diverged": "@blue",
        "git_status_staged": "@green",
        "git_status_modified": "@yellow",
        "git_status_untracked": "@foreground",
        "git_status_deleted": "@red",
        "git_status_conflicted": "@red"
      }
    },
    "tmux.theme.conf": {
      "template": "tmux/default.conf",
      "values": {
        "bg": "@background",
        "active": "@blue",
        "inactive": "@white",
        "text": "@foreground",
        "accent": "@magenta",
        "border": "@bright_black"
      }
    }
  }
}
