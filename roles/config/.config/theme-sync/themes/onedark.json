{
  "palette": {
    "background": "#282c34",
    "foreground": "#abb2bf",
    "red": "#e06c75",
    "green": "#98c379",
    "yellow": "#e5c07b",
    "blue": "#61afef",
    "magenta": "#c678dd",
    "cyan": "#56b6c2",
    "bright_black": "#5c6370",
    "bright_white": "#ffffff",
    "selection": "#3e4452",
    "inactive": "#7f848e",
    "border": "#3a404b"
  },
  "mappings": {
    "GHOSTTY_THEME": "OneHalfDark",
    "NVIM_THEME": "onedark",
    "BAT_THEME": "OneHalfDark"
  },
  "files": {
    "btop.theme": {
      "template": "btop/catppuccin-latte.theme",
      "values": {
        "main_bg": "@background",
        "main_fg": "@foreground",
        "title": "@foreground",
        "hi_fg": "@blue",
        "selected_bg": "@selection",
        "selected_fg": "@foreground",
        "inactive_fg": "@bright_black",
        "graph_text": "@foreground",
        "meter_bg": "@selection",
        "proc_misc": "@yellow",
        "cpu_box": "@blue",
        "mem_box": "@green",
        "net_box": "@magenta",
        "proc_box": "@cyan",
        "div_line": "@bright_black",
        "temp_start": "@green",
        "temp_mid": "@yellow",
        "temp_end": "@red",
        "cpu_start": "@cyan",
        "cpu_mid": "@blue",
        "cpu_end": "@magenta",
        "free_start": "@green",
        "free_mid": "@cyan",
        "free_end": "@blue",
        "cached_start": "@cyan",
        "cached_mid": "@blue",
        "cached_end": "@magenta",
        "available_start": "@yellow",
        "available_mid": "@magenta",
        "available_end": "@red",
        "used_start": "@green",
        "used_mid": "@cyan",
        "used_end": "@blue",
        "download_start": "@yellow",
        "download_mid": "@magenta",
        "download_end": "@red",
        "upload_start": "@green",
        "upload_mid": "@cyan",
        "upload_end": "@blue",
        "process_start": "@cyan",
        "process_mid": "@blue",
        "process_end": "@magenta"
      }
    },
    "fzf.sh": {
      "template": "fzf/carbonfox.sh",
      "values": {
        "fzf_bg_plus": "@selection",
        "fzf_bg": "@background",
        "fzf_border": "@bright_black",
        "fzf_fg": "@foreground",
        "fzf_gutter": "@background",
        "fzf_header": "@magenta",
        "fzf_hl_plus": "@blue",
        "fzf_hl": "@blue",
        "fzf_info": "@bright_black",
        "fzf_marker": "@magenta",
        "fzf_pointer": "@magenta",
        "fzf_prompt": "@green",
        "fzf_query": "@foreground",
        "fzf_scrollbar": "@bright_black",
        "fzf_separator": "@magenta",
        "fzf_spinner": "@magenta"
      }
    },
    "kitty.conf": {
      "template": "kitty/dracula.conf",
      "values": {
        "active_border_color": "@blue",
        "active_tab_background": "@blue",
        "active_tab_foreground": "@background",
        "background": "@background",
        "color0": "@background",
        "color1": "@red",
        "color10": "@green",
        "color11": "@yellow",
        "color12": "@blue",
        "color13": "@magenta",
        "color14": "@cyan",
        "color15": "@bright_white",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@foreground",
        "color8": "@bright_black",
        "color9": "@red",
        "cursor": "@foreground",
        "cursor_text_color": "@background",
        "foreground": "@foreground",
        "inactive_border_color": "@selection",
        "inactive_tab_background": "@selection",
        "inactive_tab_foreground": "@foreground",
        "selection_background": "@selection",
        "selection_foreground": "@foreground",
        "url_color": "@blue"
      }
    },
    "tmux.theme.conf": {
      "template": "tmux/default.conf",
      "values": {
        "bg": "@background",
        "active": "@blue",
        "inactive": "@inactive",
        "text": "@foreground",
        "accent": "@magenta",
        "border": "@border"
      }
    },
    "ghostty": {
      "template": "ghostty/terminal.conf",
      "values": {
        "foreground": "@foreground",
        "background": "@background",
        "cursor": "@foreground",
        "selection_foreground": "@foreground",
        "selection_background": "@selection",
        "color0": "@background",
        "color1": "@red",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@foreground",
        "color8": "@bright_black",
        "color9": "@red",
        "color10": "@green",
        "color11": "@yellow",
        "color12": "@blue",
        "color13": "@magenta",
        "color14": "@cyan",
        "color15": "@bright_white"
      }
    }
  }
}
