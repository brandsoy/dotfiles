{
  "palette": {
    "background": "#060606",
    "foreground": "#e4e4e8",
    "black": "#000000",
    "red": "#e08585",
    "green": "#6fbe80",
    "yellow": "#c2916a",
    "blue": "#75a1c7",
    "magenta": "#c4a8d6",
    "white": "#c7c7c7",
    "bright_black": "#888888",
    "bright_yellow": "#d9a35a",
    "bright_blue": "#8c9cb8",
    "bright_white": "#ffffff",
    "selection": "#404040",
    "surface": "#1c1c1c",
    "selection_soft": "#384048",
    "grey_warm": "#605958",
    "comment": "#7c7c7c",
    "grey_mid": "#989898",
    "grey_light": "#a8a8a8",
    "string": "#9eb38e",
    "hint": "#b09080",
    "cursor_line": "#212121",
    "gutter_foreground": "#2f2b2b",
    "keyword": "#e19067",
    "diff_added_background": "#102018",
    "diff_removed_background": "#241010"
  },
  "mappings": {
    "GHOSTTY_THEME": "SupaTheme",
    "NVIM_THEME": "SupaTheme",
    "BAT_THEME": "SupaTheme"
  },
  "files": {
    "bat.tmTheme": {
      "template": "bat/default.tmTheme",
      "values": {
        "background": "@background",
        "foreground": "@foreground",
        "caret": "@foreground",
        "line_highlight": "@cursor_line",
        "selection": "@selection",
        "invisibles": "@grey_warm",
        "gutter_foreground": "@gutter_foreground",
        "comment": "@comment",
        "string": "@string",
        "string_escape": "@grey_light",
        "keyword": "@keyword",
        "import": "@grey_warm",
        "function": "@blue",
        "type": "@magenta",
        "punctuation": "@grey_light",
        "separator": "@grey_mid",
        "variable": "@foreground",
        "parameter": "@white",
        "attribute": "@foreground",
        "heading": "@white",
        "bold": "@grey_light",
        "link": "@green",
        "list": "@grey_light",
        "diff_add": "@green",
        "diff_delete": "@red",
        "diff_change": "@yellow",
        "invalid_foreground": "@foreground",
        "invalid_background": "@red"
      }
    },
    "fzf.sh": {
      "template": "fzf/default.sh",
      "values": {
        "fzf_bg_plus": "@surface",
        "fzf_bg": "@background",
        "fzf_spinner": "@grey_light",
        "fzf_hl": "@yellow",
        "fzf_fg": "@foreground",
        "fzf_header": "@yellow",
        "fzf_info": "@bright_blue",
        "fzf_pointer": "@grey_light",
        "fzf_marker": "@hint",
        "fzf_fg_plus": "@white",
        "fzf_prompt": "@blue",
        "fzf_hl_plus": "@yellow",
        "fzf_border": "@background"
      }
    },
    "ghostty": {
      "template": "ghostty/default.conf",
      "values": {
        "background": "@background",
        "color0": "@black",
        "color1": "@red",
        "color10": "@green",
        "color11": "@bright_yellow",
        "color12": "@bright_blue",
        "color13": "@magenta",
        "color14": "@blue",
        "color15": "@bright_white",
        "color16": "@grey_light",
        "color17": "@yellow",
        "color18": "@surface",
        "color19": "@selection",
        "color2": "@green",
        "color20": "@bright_black",
        "color21": "@white",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@blue",
        "color7": "@white",
        "color8": "@bright_black",
        "color9": "@red",
        "cursor_color": "@foreground",
        "foreground": "@foreground",
        "selection_background": "@selection",
        "selection_foreground": "@foreground"
      }
    },
    "kitty.conf": {
      "template": "kitty/default.conf",
      "values": {
        "active_tab_background": "@surface",
        "active_tab_foreground": "@foreground",
        "background": "@background",
        "bell_border_color": "@red",
        "color0": "@black",
        "color1": "@red",
        "color10": "@green",
        "color11": "@bright_yellow",
        "color12": "@bright_blue",
        "color13": "@magenta",
        "color14": "@blue",
        "color15": "@bright_white",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@blue",
        "color7": "@white",
        "color8": "@bright_black",
        "color9": "@red",
        "cursor": "@foreground",
        "cursor_text_color": "@background",
        "foreground": "@foreground",
        "inactive_tab_background": "@background",
        "inactive_tab_foreground": "@bright_black",
        "selection_background": "@selection",
        "selection_foreground": "@foreground",
        "tab_bar_background": "@background"
      }
    },
    "lazygit.yml": {
      "template": "lazygit/default.yml",
      "values": {
        "activeBorderColor": "@blue",
        "inactiveBorderColor": "@selection",
        "optionsTextColor": "@blue",
        "selectedLineBgColor": "@selection_soft",
        "selectedRangeBgColor": "@selection_soft",
        "cherryPickedCommitBgColor": "@magenta",
        "cherryPickedCommitFgColor": "@blue",
        "unstagedChangesColor": "@red",
        "defaultFgColor": "@foreground",
        "searchingActiveBorderColor": "@bright_yellow"
      }
    },
    "opencode.theme.json": {
      "template": "opencode/default.json",
      "values": {
        "background": "@background",
        "panel": "@surface",
        "surface": "@selection",
        "text": "@foreground",
        "muted": "@bright_black",
        "red": "@red",
        "green": "@green",
        "yellow": "@bright_yellow",
        "orange": "@yellow",
        "blue": "@blue",
        "blue_bright": "@bright_blue",
        "purple": "@magenta",
        "diff_added_bg": "@diff_added_background",
        "diff_removed_bg": "@diff_removed_background",
        "diff_added_line_number_bg": "@diff_added_background",
        "diff_removed_line_number_bg": "@diff_removed_background"
      }
    },
    "starship.toml": {
      "template": "starship/default.toml",
      "values": {
        "black": "@black",
        "red": "@red",
        "green": "@green",
        "yellow": "@yellow",
        "blue": "@blue",
        "purple": "@magenta",
        "cyan": "@blue",
        "white": "@white",
        "bright_black": "@bright_black",
        "bright_red": "@red",
        "bright_green": "@green",
        "bright_yellow": "@bright_yellow",
        "bright_blue": "@bright_blue",
        "bright_purple": "@magenta",
        "bright_cyan": "@blue",
        "bright_white": "@bright_white"
      }
    },
    "tmux.theme.conf": {
      "template": "tmux/default.conf",
      "values": {
        "bg": "@background",
        "active": "@blue",
        "inactive": "@bright_black",
        "text": "@foreground",
        "accent": "@magenta",
        "border": "@selection"
      }
    },
    "btop.theme": {
      "template": "btop/default.theme",
      "values": {
        "main_bg": "@background",
        "main_fg": "@foreground",
        "title": "@foreground",
        "hi_fg": "@blue",
        "selected_bg": "@selection",
        "selected_fg": "@foreground",
        "inactive_fg": "@bright_black",
        "proc_misc": "@blue",
        "cpu_box": "@blue",
        "mem_box": "@blue",
        "net_box": "@blue",
        "proc_box": "@blue",
        "div_line": "@bright_black",
        "temp_start": "@green",
        "temp_mid": "@blue",
        "temp_end": "@red",
        "cpu_start": "@green",
        "cpu_mid": "@blue",
        "cpu_end": "@red",
        "free_start": "@green",
        "free_mid": "@blue",
        "free_end": "@red",
        "cached_start": "@green",
        "cached_mid": "@blue",
        "cached_end": "@red",
        "available_start": "@green",
        "available_mid": "@blue",
        "available_end": "@red",
        "used_start": "@green",
        "used_mid": "@blue",
        "used_end": "@red",
        "download_start": "@green",
        "download_mid": "@blue",
        "download_end": "@red",
        "upload_start": "@green",
