{
  "palette": {
    "background": "#161616",
    "foreground": "#f2f4f8",
    "black": "#282828",
    "red": "#ee5396",
    "green": "#25be6a",
    "yellow": "#08bdba",
    "blue": "#78a9ff",
    "magenta": "#be95ff",
    "cyan": "#33b1ff",
    "white": "#dfdfe0",
    "bright_black": "#484848",
    "bright_red": "#f16da6",
    "bright_green": "#46c880",
    "bright_yellow": "#2dc7c4",
    "bright_blue": "#8cb6ff",
    "bright_magenta": "#c8a5ff",
    "bright_cyan": "#52bdff",
    "bright_white": "#e4e4e5",
    "selection": "#2a2a2a",
    "active_tab_foreground": "#0c0c0c",
    "bell_border_color": "#3ddbd9",
    "inactive_border_color": "#535353",
    "inactive_tab_foreground": "#6e6f70",
    "color17": "#ff7eb6"
  },
  "mappings": {
    "GHOSTTY_THEME": "Carbonfox",
    "NVIM_THEME": "carbonfox",
    "BAT_THEME": "carbonfox",
    "VSCODE_THEME": "Dracula"
  },
  "files": {
    "btop.theme": {
      "template": "btop/default.theme",
      "values": {
        "main_bg": "@background",
        "main_fg": "@foreground",
        "title": "@foreground",
        "hi_fg": "@blue",
        "selected_bg": "@selection",
        "selected_fg": "@foreground",
        "inactive_fg": "@inactive_tab_foreground",
        "proc_misc": "@cyan",
        "cpu_box": "@inactive_border_color",
        "mem_box": "@inactive_border_color",
        "net_box": "@inactive_border_color",
        "proc_box": "@inactive_border_color",
        "div_line": "@inactive_border_color",
        "temp_start": "@green",
        "temp_mid": "@yellow",
        "temp_end": "@red",
        "cpu_start": "@green",
        "cpu_mid": "@yellow",
        "cpu_end": "@red",
        "free_start": "@green",
        "free_mid": "@yellow",
        "free_end": "@red",
        "cached_start": "@green",
        "cached_mid": "@yellow",
        "cached_end": "@red",
        "available_start": "@green",
        "available_mid": "@yellow",
        "available_end": "@red",
        "used_start": "@green",
        "used_mid": "@yellow",
        "used_end": "@red",
        "download_start": "@green",
        "download_mid": "@yellow",
        "download_end": "@red",
        "upload_start": "@green",
        "upload_mid": "@yellow",
        "upload_end": "@red"
      }
    },
    "fzf.sh": {
      "template": "fzf/carbonfox.sh",
      "values": {
        "fzf_bg_plus": "@selection",
        "fzf_bg": "@background",
        "fzf_border": "@blue",
        "fzf_fg": "@foreground",
        "fzf_gutter": "@background",
        "fzf_header": "@yellow",
        "fzf_hl_plus": "@cyan",
        "fzf_hl": "@blue",
        "fzf_info": "@inactive_tab_foreground",
        "fzf_marker": "@red",
        "fzf_pointer": "@magenta",
        "fzf_prompt": "@green",
        "fzf_query": "@foreground",
        "fzf_scrollbar": "@blue",
        "fzf_separator": "@yellow",
        "fzf_spinner": "@magenta"
      }
    },
    "kitty.conf": {
      "template": "kitty/carbonfox.conf",
      "values": {
        "active_border_color": "@blue",
        "active_tab_background": "@blue",
        "active_tab_foreground": "@active_tab_foreground",
        "background": "@background",
        "bell_border_color": "@bell_border_color",
        "color0": "@black",
        "color1": "@red",
        "color10": "@bright_green",
        "color11": "@bright_yellow",
        "color12": "@bright_blue",
        "color13": "@bright_magenta",
        "color14": "@bright_cyan",
        "color15": "@bright_white",
        "color16": "@bell_border_color",
        "color17": "@color17",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@white",
        "color8": "@bright_black",
        "color9": "@bright_red",
        "cursor": "@foreground",
        "cursor_text_color": "@background",
        "foreground": "@foreground",
        "inactive_border_color": "@inactive_border_color",
        "inactive_tab_background": "@selection",
        "inactive_tab_foreground": "@inactive_tab_foreground",
        "selection_background": "@selection",
        "selection_foreground": "@foreground",
        "url_color": "@green"
      }
    },
    "ghostty": {
      "template": "ghostty/terminal.conf",
      "values": {
        "foreground": "@foreground",
        "background": "@background",
        "cursor": "@foreground",
        "selection_foreground": "@foreground",
        "selection_background": "@selection",
        "color0": "@black",
        "color1": "@red",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@white",
        "color8": "@bright_black",
        "color9": "@bright_red",
        "color10": "@bright_green",
        "color11": "@bright_yellow",
        "color12": "@bright_blue",
        "color13": "@bright_magenta",
        "color14": "@bright_cyan",
        "color15": "@bright_white"
      }
    },
    "tmux.theme.conf": {
      "template": "tmux/default.conf",
      "values": {
        "bg": "@background",
        "active": "@blue",
        "inactive": "@bright_black",
        "text": "@foreground",
        "accent": "@magenta",
        "border": "@selection"
      }
    }
  }
}
