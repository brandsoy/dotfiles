{
  "palette": {
    "background": "#191919",
    "foreground": "#bbbbbb",
    "red": "#de6e7c",
    "green": "#819b69",
    "yellow": "#b77e64",
    "blue": "#6099c0",
    "magenta": "#b279a7",
    "cyan": "#66a5ad",
    "bright_black": "#3d3839",
    "bright_red": "#e8838f",
    "bright_green": "#8bae68",
    "bright_yellow": "#d68c67",
    "bright_blue": "#61abda",
    "bright_magenta": "#cf86c1",
    "bright_cyan": "#65b8c1",
    "bright_white": "#8e8e8e",
    "selection": "#404040",
    "cursor": "#c9c9c9",
    "active_tab_background": "#65435e",
    "inactive_tab_background": "#303030"
  },
  "mappings": {
    "GHOSTTY_THEME": "zenwritten_dark",
    "NVIM_THEME": "zenwritten",
    "BAT_THEME": "zenburn",
    "VSCODE_THEME": "Dracula"
  },
  "files": {
    "fzf.sh": {
      "template": "fzf/carbonfox.sh",
      "values": {
        "fzf_bg_plus": "@inactive_tab_background",
        "fzf_bg": "@background",
        "fzf_border": "@blue",
        "fzf_fg": "@foreground",
        "fzf_gutter": "@background",
        "fzf_header": "@yellow",
        "fzf_hl_plus": "@bright_blue",
        "fzf_hl": "@blue",
        "fzf_info": "@bright_white",
        "fzf_marker": "@red",
        "fzf_pointer": "@magenta",
        "fzf_prompt": "@cyan",
        "fzf_query": "@foreground",
        "fzf_scrollbar": "@blue",
        "fzf_separator": "@yellow",
        "fzf_spinner": "@magenta"
      }
    },
    "kitty.conf": {
      "template": "kitty/zenwritten-dark.conf",
      "values": {
        "active_tab_background": "@active_tab_background",
        "active_tab_foreground": "@foreground",
        "background": "@background",
        "color0": "@background",
        "color1": "@red",
        "color10": "@bright_green",
        "color11": "@bright_yellow",
        "color12": "@bright_blue",
        "color13": "@bright_magenta",
        "color14": "@bright_cyan",
        "color15": "@bright_white",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@foreground",
        "color8": "@bright_black",
        "color9": "@bright_red",
        "cursor": "@cursor",
        "cursor_text_color": "@background",
        "foreground": "@foreground",
        "inactive_tab_background": "@inactive_tab_background",
        "inactive_tab_foreground": "@foreground",
        "selection_background": "@selection",
        "selection_foreground": "@foreground"
      }
    },
    "ghostty": {
      "template": "ghostty/terminal.conf",
      "values": {
        "foreground": "@foreground",
        "background": "@background",
        "cursor": "@cursor",
        "selection_foreground": "@foreground",
        "selection_background": "@selection",
        "color0": "@background",
        "color1": "@red",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@foreground",
        "color8": "@bright_black",
        "color9": "@bright_red",
        "color10": "@bright_green",
        "color11": "@bright_yellow",
        "color12": "@bright_blue",
        "color13": "@bright_magenta",
        "color14": "@bright_cyan",
        "color15": "@bright_white"
      }
    },
    "btop.theme": {
      "template": "btop/default.theme",
      "values": {
        "main_bg": "@background",
        "main_fg": "@foreground",
        "title": "@foreground",
        "hi_fg": "@blue",
        "selected_bg": "@selection",
        "selected_fg": "@foreground",
        "inactive_fg": "@bright_black",
        "proc_misc": "@cyan",
        "cpu_box": "@blue",
        "mem_box": "@blue",
        "net_box": "@blue",
        "proc_box": "@blue",
        "div_line": "@bright_black",
        "temp_start": "@green",
        "temp_mid": "@cyan",
        "temp_end": "@red",
        "cpu_start": "@green",
        "cpu_mid": "@cyan",
        "cpu_end": "@red",
        "free_start": "@green",
        "free_mid": "@cyan",
        "free_end": "@red",
        "cached_start": "@green",
        "cached_mid": "@cyan",
        "cached_end": "@red",
        "available_start": "@green",
        "available_mid": "@cyan",
        "available_end": "@red",
        "used_start": "@green",
        "used_mid": "@cyan",
        "used_end": "@red",
        "download_start": "@green",
        "download_mid": "@cyan",
        "download_end": "@red",
        "upload_start": "@green",
        "upload_mid": "@cyan",
        "upload_end": "@red"
      }
    },
    "tmux.theme.conf": {
      "template": "tmux/default.conf",
      "values": {
        "bg": "@background",
        "active": "@blue",
        "inactive": "@bright_black",
        "text": "@foreground",
        "accent": "@magenta",
        "border": "@selection"
      }
    }
  }
}
