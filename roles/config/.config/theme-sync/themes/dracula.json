{
  "palette": {
    "background": "#282a36",
    "foreground": "#f8f8f2",
    "black": "#21222c",
    "red": "#ff5555",
    "green": "#50fa7b",
    "yellow": "#f1fa8c",
    "blue": "#bd93f9",
    "magenta": "#ff79c6",
    "cyan": "#8be9fd",
    "bright_black": "#6272a4",
    "bright_red": "#ff6e6e",
    "bright_green": "#69ff94",
    "bright_yellow": "#ffffa5",
    "bright_blue": "#d6acff",
    "bright_magenta": "#ff92df",
    "bright_cyan": "#a4ffff",
    "bright_white": "#ffffff",
    "selection": "#44475a"
  },
  "mappings": {
    "GHOSTTY_THEME": "dracula",
    "NVIM_THEME": "dracula",
    "BAT_THEME": "Dracula",
    "VSCODE_THEME": "Dracula"
  },
  "files": {
    "btop.theme": {
      "template": "btop/catppuccin-latte.theme",
      "values": {
        "main_bg": "@background",
        "main_fg": "@foreground",
        "title": "@foreground",
        "hi_fg": "@blue",
        "selected_bg": "@selection",
        "selected_fg": "@foreground",
        "inactive_fg": "@bright_black",
        "graph_text": "@foreground",
        "meter_bg": "@selection",
        "proc_misc": "@yellow",
        "cpu_box": "@blue",
        "mem_box": "@green",
        "net_box": "@magenta",
        "proc_box": "@cyan",
        "div_line": "@bright_black",
        "temp_start": "@green",
        "temp_mid": "@yellow",
        "temp_end": "@red",
        "cpu_start": "@cyan",
        "cpu_mid": "@blue",
        "cpu_end": "@magenta",
        "free_start": "@green",
        "free_mid": "@cyan",
        "free_end": "@blue",
        "cached_start": "@cyan",
        "cached_mid": "@blue",
        "cached_end": "@magenta",
        "available_start": "@yellow",
        "available_mid": "@magenta",
        "available_end": "@red",
        "used_start": "@green",
        "used_mid": "@cyan",
        "used_end": "@blue",
        "download_start": "@yellow",
        "download_mid": "@magenta",
        "download_end": "@red",
        "upload_start": "@green",
        "upload_mid": "@cyan",
        "upload_end": "@blue",
        "process_start": "@cyan",
        "process_mid": "@blue",
        "process_end": "@magenta"
      }
    },
    "fzf.sh": {
      "template": "fzf/carbonfox.sh",
      "values": {
        "fzf_bg_plus": "@selection",
        "fzf_bg": "@background",
        "fzf_border": "@bright_black",
        "fzf_fg": "@foreground",
        "fzf_gutter": "@background",
        "fzf_header": "@magenta",
        "fzf_hl_plus": "@cyan",
        "fzf_hl": "@cyan",
        "fzf_info": "@bright_black",
        "fzf_marker": "@magenta",
        "fzf_pointer": "@magenta",
        "fzf_prompt": "@blue",
        "fzf_query": "@foreground",
        "fzf_scrollbar": "@bright_black",
        "fzf_separator": "@magenta",
        "fzf_spinner": "@magenta"
      }
    },
    "kitty.conf": {
      "template": "kitty/dracula.conf",
      "values": {
        "active_border_color": "@blue",
        "active_tab_background": "@blue",
        "active_tab_foreground": "@background",
        "background": "@background",
        "color0": "@black",
        "color1": "@red",
        "color10": "@bright_green",
        "color11": "@bright_yellow",
        "color12": "@bright_blue",
        "color13": "@bright_magenta",
        "color14": "@bright_cyan",
        "color15": "@bright_white",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@foreground",
        "color8": "@bright_black",
        "color9": "@bright_red",
        "cursor": "@foreground",
        "cursor_text_color": "@background",
        "foreground": "@foreground",
        "inactive_border_color": "@selection",
        "inactive_tab_background": "@selection",
        "inactive_tab_foreground": "@foreground",
        "selection_background": "@selection",
        "selection_foreground": "@foreground",
        "url_color": "@cyan"
      }
    },
    "tmux.theme.conf": {
      "template": "tmux/default.conf",
      "values": {
        "bg": "@background",
        "active": "@blue",
        "inactive": "@bright_black",
        "text": "@foreground",
        "accent": "@magenta",
        "border": "@selection"
      }
    },
    "ghostty": {
      "template": "ghostty/terminal.conf",
      "values": {
        "foreground": "@foreground",
        "background": "@background",
        "cursor": "@foreground",
        "selection_foreground": "@foreground",
        "selection_background": "@selection",
        "color0": "@black",
        "color1": "@red",
        "color2": "@green",
        "color3": "@yellow",
        "color4": "@blue",
        "color5": "@magenta",
        "color6": "@cyan",
        "color7": "@foreground",
        "color8": "@bright_black",
        "color9": "@bright_red",
        "color10": "@bright_green",
        "color11": "@bright_yellow",
        "color12": "@bright_blue",
        "color13": "@bright_magenta",
        "color14": "@bright_cyan",
        "color15": "@bright_white"
      }
    }
  }
}
