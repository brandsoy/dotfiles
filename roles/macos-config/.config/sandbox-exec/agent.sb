(version 1)

;; 00-base: home-relative helpers and default deny.
(define HOME_DIR "/Users/mattis")
(define (home-subpath rel) (subpath (string-append HOME_DIR rel)))
(define (home-literal rel) (literal (string-append HOME_DIR rel)))
(define (home-prefix rel) (prefix (string-append HOME_DIR rel)))
(deny default)

;; Ancestor directories are literal reads: listings, not recursive reads.
(allow file-read*
  (literal "/") (literal "/Users") (home-literal "")
  (literal "/System") (literal "/System/Library")
  (literal "/System/Volumes") (literal "/Library")
  (literal "/Library/Preferences")
  (literal "/Library/Developer")
  (literal "/Library/Developer/CommandLineTools")
  (literal "/Library/Developer/CommandLineTools/usr")
  (literal "/Library/Developer/CommandLineTools/usr/bin")
  (literal "/Library/Developer/CommandLineTools/usr/libexec")
  (literal "/private") (literal "/private/etc")
  (literal "/private/var") (literal "/private/var/db")
  (literal "/private/var/run") (literal "/private/var/select") (literal "/dev")
  (home-literal "/.config") (home-literal "/.cache")
  (home-literal "/.local") (home-literal "/.local/share")
  (home-literal "/.local/state") (home-literal "/.local/share/mise")
  (home-literal "/.local/share/pnpm")
  (home-literal "/.local/share/uv") (home-literal "/.local/share/uv/tools")
  (home-literal "/.bun") (home-literal "/.bun/install")
  (home-literal "/.cargo") (home-literal "/go")
  (home-literal "/Library")
  (home-literal "/Library/Caches") (home-literal "/Library/pnpm")
  (literal "/Users/mattis/dotfiles")
  (literal "/Users/mattis/dotfiles/roles")
  (literal "/Users/mattis/dotfiles/roles/git")
  (literal "/Users/mattis/dotfiles/roles/vibe")
  (literal "/Users/mattis/dotfiles/roles/agents"))

;; 10-system-runtime: system programs, libraries, and standard devices.
(allow file-read*
  (subpath "/usr") (subpath "/bin") (subpath "/sbin")
  (subpath "/opt") (subpath "/System/Library")
  (subpath "/System/Volumes/Preboot")
  (subpath "/Library/Apple") (subpath "/Library/Frameworks")
  (literal "/Library/Preferences/.GlobalPreferences.plist")
  (literal "/Library/Preferences/com.apple.networkd.plist")
  (literal "/etc") (literal "/var")
  (literal "/private/etc/hosts") (literal "/private/etc/resolv.conf")
  (literal "/private/etc/services") (literal "/private/etc/protocols")
  (literal "/private/etc/shells") (literal "/private/etc/localtime")
  (subpath "/private/etc/ssl") (subpath "/private/var/db/timezone")
  (literal "/private/var/select/developer_dir")
  (literal "/private/var/select/sh")
  (literal "/private/var/db/xcode_select_link")
  (home-literal "/.CFUserTextEncoding")
  (home-prefix "/Library/Preferences/.GlobalPreferences")
  (home-prefix "/Library/Preferences/com.apple.GlobalPreferences")
  (literal "/dev/zero") (literal "/dev/urandom") (literal "/dev/random")
  (literal "/dev/autofs_nowait"))
(allow file-read-metadata
  (subpath "/System") (subpath "/dev")
  (subpath "/private/var/run") (literal "/pkg/env/global"))
(allow process-exec)
(allow process-fork)
(allow sysctl-read)
(allow process-info* (target same-sandbox))
(allow signal (target same-sandbox))
(allow mach-priv-task-port (target same-sandbox))
(allow pseudo-tty)
(deny sysctl-read (sysctl-name-regex #"procargs"))
(deny process-info-pidinfo)
(allow process-info-pidinfo (target same-sandbox))
(allow file-read* file-write*
  (subpath "/tmp") (subpath "/private/tmp")
  (subpath "/var/folders") (subpath "/private/var/folders")
  (subpath "/dev/fd") (literal "/dev/stdout") (literal "/dev/stderr")
  (literal "/dev/null") (literal "/dev/tty") (literal "/dev/ptmx")
  (literal "/dev/dtracehelper") (regex #"^/dev/tty") (regex #"^/dev/pty"))
(allow file-ioctl
  (literal "/dev/tty") (literal "/dev/ptmx") (literal "/dev/dtracehelper")
  (regex #"^/dev/tty") (regex #"^/dev/pty"))
(allow mach-lookup
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.logd") (global-name "com.apple.FSEvents")
  (global-name "com.apple.SystemConfiguration.configd")
  (global-name "com.apple.SystemConfiguration.DNSConfiguration")
  (global-name "com.apple.trustd.agent")
  (global-name "com.apple.diagnosticd") (global-name "com.apple.analyticsd")
  (global-name "com.apple.dnssd.service")
  (global-name "com.apple.CoreServices.coreservicesd")
  (global-name "com.apple.DiskArbitration.diskarbitrationd")
  (global-name "com.apple.analyticsd.messagetracer")
  (global-name "com.apple.system.logger")
  (global-name "com.apple.coreservices.launchservicesd"))
(allow system-socket)
(allow ipc-posix-shm-read-data (ipc-posix-name "apple.shm.notification_center"))
;; LMDB uses System V semaphores for cross-process locking on macOS.
(allow ipc-sysv-sem)

;; 20-network: TCP/UDP are unrestricted; this does not prevent exfiltration.
(allow network-outbound (remote ip))
(allow network-outbound (literal "/private/var/run/mDNSResponder"))
(allow network-bind (local ip))
(allow network-inbound (local ip))

;; 30-toolchains: installed mise runtimes and Homebrew Rust are read-only.
(allow file-read*
  (home-subpath "/.local/bin")
  (home-subpath "/.local/share/mise/installs")
  (home-subpath "/.local/share/mise/shims")
  (home-subpath "/.local/share/uv/tools/mistral-vibe")
  (home-subpath "/.local/share/uv/python")
  (home-subpath "/.local/share/pnpm")
  (home-subpath "/.config/mise")
  (home-literal "/.mise.toml")
  (literal "/Library/Developer/CommandLineTools/usr/bin/git")
  (literal "/Library/Developer/CommandLineTools/usr/bin/clang")
  (literal "/Library/Developer/CommandLineTools/usr/bin/cc")
  (literal "/Library/Developer/CommandLineTools/usr/bin/c++")
  (literal "/Library/Developer/CommandLineTools/usr/bin/make")
  (literal "/Library/Developer/CommandLineTools/usr/bin/ld")
  (subpath "/Library/Developer/CommandLineTools/usr/libexec/git-core")
  (subpath "/Library/Developer/CommandLineTools/usr/lib")
  (subpath "/Library/Developer/CommandLineTools/usr/include")
  (subpath "/Library/Developer/CommandLineTools/usr/share")
  (subpath "/Library/Developer/CommandLineTools/SDKs"))
;; Build and package caches only; installed runtimes stay read-only.
(allow file-read* file-write*
  (home-subpath "/.npm") (home-subpath "/.cache/node")
  (home-subpath "/.cache/node-gyp") (home-subpath "/.node-gyp")
  (home-subpath "/.local/share/pnpm/store") (home-subpath "/.local/state/pnpm")
  (home-subpath "/Library/Caches/pnpm") (home-subpath "/Library/pnpm/store")
  (home-subpath "/.bun/install/cache") (home-subpath "/.cache/bun")
  (home-subpath "/.cache/pip") (home-subpath "/.cache/uv")
  (home-subpath "/.cache/ruff") (home-subpath "/.cache/mypy")
  (home-subpath "/go/pkg") (home-subpath "/.cache/go-build")
  (home-subpath "/Library/Caches/go-build")
  (home-subpath "/.cargo/registry") (home-subpath "/.cargo/git")
  (home-subpath "/.cache/mise") (home-subpath "/.local/state/mise"))

;; 40-shared: shared guidance is read-only, including the resolved symlink.
(allow file-read*
  (home-subpath "/.agents")
  (subpath "/Users/mattis/dotfiles/roles/agents/.agents")
  (home-subpath "/.skills") (home-literal "/AGENTS.md")
  (home-subpath "/.claude/agents") (home-subpath "/.claude/skills")
  (home-literal "/CLAUDE.md"))
(allow file-read* (home-literal "/.claude"))

;; 50-core: explicit Git config and read-only gh authentication/config.
(allow file-read*
  (home-literal "/.gitconfig")
  (literal "/Users/mattis/dotfiles/roles/git/.gitconfig")
  (home-subpath "/.config/gh"))
(allow file-read* file-write* (home-subpath "/.cache/gh"))
;; Git worktree rules are added by the launcher.

;; 55-optional: no Keychain, shell-init, browser, SSH or container integration.

;; 60-agents: state can contain credentials and is writable by sandboxed code.
(allow file-read* file-write*
  (home-subpath "/.config/opencode") (home-subpath "/.cache/opencode")
  (home-subpath "/.local/share/opencode")
  (home-subpath "/.local/state/opencode")
  (home-subpath "/.local/share/opentui")
  (home-subpath "/.opencode") (home-literal "/.opencode.json")
  (home-subpath "/.pi")
  (home-subpath "/.pi-bolt")
  (home-subpath "/.vibe"))
(allow file-read* (subpath "/Users/mattis/dotfiles/roles/vibe/.vibe"))

;; Sensitive integrations: repeated after dynamic grants by the launcher.
(deny file-read* file-write* file-read-metadata
  (home-subpath "/.ssh")
  (home-subpath "/Library/Keychains")
  (home-subpath "/Library/Application Support/Google/Chrome")
  (home-subpath "/Library/Application Support/Firefox")
  (home-subpath "/Library/Safari")
  (home-literal "/.zshenv") (home-literal "/.zprofile")
  (home-literal "/.zshrc") (home-literal "/.bashrc")
  (home-literal "/.bash_profile")
  (home-subpath "/.config/zsh")
  (subpath "/Users/mattis/dotfiles/roles/config/.config/zsh")
  (literal "/Users/mattis/dotfiles/roles/zshenv/.zshenv")
  (literal "/var/run/docker.sock") (literal "/private/var/run/docker.sock")
  (home-literal "/.docker/run/docker.sock")
  (home-literal "/.rd/docker.sock")
  (home-literal "/.orbstack/run/docker.sock")
  (regex #"^/private/tmp/com\.apple\.launchd\.[^/]+/Listeners$")
  (regex #"^/private/var/run/com\.apple\.launchd\.[^/]+/Listeners$"))
(deny network-outbound
  (remote unix-socket (path-literal "/var/run/docker.sock"))
  (remote unix-socket (path-literal "/private/var/run/docker.sock"))
  (remote unix-socket (path-regex #"^/private/tmp/com\.apple\.launchd\.[^/]+/Listeners$"))
  (remote unix-socket (path-regex #"^/private/var/run/com\.apple\.launchd\.[^/]+/Listeners$")))
