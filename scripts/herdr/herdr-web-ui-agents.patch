+import { afterAll, expect, test } from "bun:test";
+import { Database } from "bun:sqlite";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { ConversationUnavailable, HistoryChanged } from "./conversation.ts";
+import { openCodeConversation, openCodeToolOutput } from "./opencode.ts";
+
+const root = mkdtempSync(join(tmpdir(), "herdr-opencode-"));
+const path = join(root, "opencode.db");
+const db = new Database(path);
+db.exec(`CREATE TABLE session (id TEXT PRIMARY KEY, revert TEXT);
+  CREATE TABLE message (id TEXT PRIMARY KEY, session_id TEXT, time_created INTEGER, data TEXT);
+  CREATE TABLE part (id TEXT PRIMARY KEY, session_id TEXT, message_id TEXT, data TEXT);`);
+db.query("INSERT INTO session VALUES (?, NULL)").run("ses_test");
+db.query("INSERT INTO session VALUES (?, NULL)").run("ses_other");
+for (let i = 0; i < 85; i++) {
+  const id = `msg_${String(i).padStart(3, "0")}`;
+  db.query("INSERT INTO message VALUES (?, ?, ?, ?)").run(id, "ses_test", i * 1000, JSON.stringify({ role: i % 2 ? "assistant" : "user", modelID: "test-model", variant: "high", time: { completed: i * 1000 + 500 } }));
+  db.query("INSERT INTO part VALUES (?, ?, ?, ?)").run(`prt_${i}`, "ses_test", id, JSON.stringify({ type: "text", text: `message ${i}` }));
+}
+db.query("INSERT INTO part VALUES (?, ?, ?, ?)").run("prt_tool", "ses_test", "msg_083", JSON.stringify({ type: "tool", tool: "bash", state: { status: "error", input: { command: "false" }, error: "x".repeat(5000) } }));
+db.query("INSERT INTO message VALUES (?, ?, ?, ?)").run("msg_secret", "ses_other", 999999, JSON.stringify({ role: "user" }));
+db.query("INSERT INTO part VALUES (?, ?, ?, ?)").run("prt_secret", "ses_other", "msg_secret", JSON.stringify({ type: "text", text: "other session secret" }));
+afterAll(() => { db.close(); rmSync(root, { recursive: true, force: true }); });
+
+test("OpenCode reads only the exact session, with tool output and metadata", () => {
+  const answer = openCodeConversation("ses_test", {}, path);
+  expect(answer.source).toBe("opencode-transcript");
+  expect(answer.turns).toHaveLength(80);
+  expect(answer.metadata).toEqual({ model: "test-model", reasoning_effort: "high" });
+  expect(JSON.stringify(answer)).not.toContain("other session secret");
+  const tool = answer.turns.flatMap(turn => turn.parts).find(part => part.kind === "tool");
+  expect(tool).toMatchObject({ kind: "tool", name: "bash", error: true, output_ref: "prt_tool", output_size: 5000 });
+  expect(openCodeToolOutput("ses_test", "prt_tool", path)).toHaveLength(5000);
+  expect(openCodeToolOutput("ses_other", "prt_tool", path)).toBeNull();
+});
+
+test("OpenCode pagination, polling versions, and session replacement", () => {
+  const latest = openCodeConversation("ses_test", {}, path);
+  const older = openCodeConversation("ses_test", { before: latest.cursor! }, path);
+  expect(older.turns).toHaveLength(5);
+  expect(older.cursor).toBeNull();
+  expect(openCodeConversation("ses_test", { from: latest.cursor! }, path).turns).toEqual(latest.turns);
+  expect(openCodeConversation("ses_test", {}, path).version).toBe(latest.version);
+  expect(() => openCodeConversation("ses_other", { before: latest.cursor! }, path)).toThrow(HistoryChanged);
+  expect(() => openCodeConversation("ses_missing", {}, path)).toThrow(ConversationUnavailable);
+  db.query("UPDATE part SET data = ? WHERE id = ?").run(JSON.stringify({ type: "text", text: "streamed update" }), "prt_84");
+  expect(openCodeConversation("ses_test", {}, path).version).not.toBe(latest.version);
+  db.query("UPDATE session SET revert = ? WHERE id = ?").run(JSON.stringify({ messageID: "msg_080" }), "ses_test");
+  expect(openCodeConversation("ses_test", {}, path).turns).toHaveLength(80);
+  expect(() => openCodeConversation("ses_test", { before: latest.cursor! }, path)).toThrow(HistoryChanged);
+});
diff --git a/server/opencode.ts b/server/opencode.ts
new file mode 100644
index 0000000..78b5719
--- /dev/null
+++ b/server/opencode.ts
@@ -0,0 +1,101 @@
+import { Database } from "bun:sqlite";
+import { createHash } from "node:crypto";
+import { homedir } from "node:os";
+import { join } from "node:path";
+import type { ConversationMetadata, ConversationPart, ConversationTurn, HerdrPane } from "../shared/protocol.ts";
+import { ConversationUnavailable, HistoryChanged, type ConversationPage, type RecognizedConversation } from "./conversation.ts";
+import { trimOutput } from "./tool-output.ts";
+
+export type OpenCodeConversation = Omit<RecognizedConversation, "source"> & { source: "opencode-transcript" };
+export const defaultOpenCodeDatabase = () => join(process.env["XDG_DATA_HOME"] || join(homedir(), ".local", "share"), "opencode", "opencode.db");
+
+export function openCodeSession(pane: HerdrPane): string {
+  const session = pane.agent_session;
+  if (pane.agent !== "opencode" || session?.agent !== "opencode" || session.kind !== "id" || !/^ses_[A-Za-z0-9]+$/.test(session.value)) {
+    throw new ConversationUnavailable("no_session_path");
+  }
+  return session.value;
+}
+
+function readDatabase<T>(path: string, read: (db: Database) => T): T {
+  let db: Database | undefined;
+  try {
+    db = new Database(path, { readonly: true });
+    return db.transaction(() => read(db!))();
+  } catch (error) {
+    if (error instanceof HistoryChanged || error instanceof ConversationUnavailable) throw error;
+    throw new ConversationUnavailable("opencode_database_unavailable");
+  } finally { db?.close(); }
+}
+
+/** Exact reported session only; never choose a session by cwd, title or recency. */
+export function openCodeConversation(sessionId: string, page: ConversationPage = {}, path = defaultOpenCodeDatabase()): OpenCodeConversation {
+  return readDatabase(path, db => {
+    const session = db.query("SELECT revert FROM session WHERE id = ?").get(sessionId) as { revert: string | null } | null;
+    if (!session) throw new ConversationUnavailable("session_missing");
+    const revert = session.revert ? JSON.parse(session.revert).messageID : null;
+    const historyId = createHash("sha256").update(`${path}\0${sessionId}\0${session.revert ?? ""}`).digest("base64url");
+    const cursorFor = (id: string) => `${historyId}:${id}`;
+    const cursorId = (cursor?: string): string | null => {
+      if (cursor === undefined) return null;
+      if (!cursor.startsWith(`${historyId}:`)) throw new HistoryChanged();
+      const id = cursor.slice(historyId.length + 1);
+      if (!db.query("SELECT id FROM message WHERE session_id = ? AND id = ? AND (? IS NULL OR id < ?)").get(sessionId, id, revert, revert)) throw new HistoryChanged();
+      return id;
+    };
+    const before = cursorId(page.before), since = cursorId(page.since), from = cursorId(page.from);
+    if (since && before && since > before) throw new HistoryChanged();
+    // Keep polls bounded. The client fills any gap with before + since.
+    const rows = db.query(`SELECT id, time_created, data FROM message
+      WHERE session_id = ? AND (? IS NULL OR id < ?) AND (? IS NULL OR id < ?) AND (? IS NULL OR id >= ?)
+      ORDER BY id DESC LIMIT 80`).all(sessionId, revert, revert, before, before, since, since) as { id: string; time_created: number; data: string }[];
+    rows.reverse();
+    const held = from ? rows.findIndex(row => row.id === from) : -1;
+    if (held > 0) rows.splice(0, held);
+    const turns: ConversationTurn[] = [];
+    for (const row of rows) {
+      const message = JSON.parse(row.data);
+      if (message.role !== "user" && message.role !== "assistant") continue;
+      const parts: ConversationPart[] = [];
+      const records = db.query("SELECT id, data FROM part WHERE session_id = ? AND message_id = ? ORDER BY id").all(sessionId, row.id) as { id: string; data: string }[];
+      for (const record of records) {
+        const part = JSON.parse(record.data);
+        if ((part.type === "text" || part.type === "reasoning") && typeof part.text === "string" && part.text) {
+          parts.push({ kind: part.type === "text" ? "text" : "thinking", text: part.text });
+        } else if (part.type === "tool" && typeof part.tool === "string") {
+          const state = part.state ?? {};
+          const tool: Extract<ConversationPart, { kind: "tool" }> = {
+            kind: "tool", name: part.tool, summary: state.title || part.tool,
+            input: JSON.stringify(state.input ?? {}), output: "", error: state.status === "error",
+          };
+          trimOutput(tool, String(state.output ?? state.error ?? ""), record.id);
+          parts.push(tool);
+        } else if (part.type === "file") {
+          parts.push({ kind: "notice", text: part.filename || "Attached file", source: "opencode" });
+        } else if (part.type === "compaction") {
+          parts.push({ kind: "compact", text: "Conversation compacted" });
+        }
+      }
+      if (message.error?.data?.message) parts.push({ kind: "notice", text: String(message.error.data.message), source: "opencode" });
+      if (parts.length) turns.push({ role: message.role, ts: new Date(row.time_created).toISOString(), parts,
+        ...(typeof message.time?.completed === "number" ? { end_ts: new Date(message.time.completed).toISOString() } : {}),
+      });
+    }
+    const latest = db.query(`SELECT data FROM message WHERE session_id = ? AND (? IS NULL OR id < ?)
+      AND json_extract(data, '$.role') = 'assistant' ORDER BY id DESC LIMIT 1`).get(sessionId, revert, revert) as { data: string } | null;
+    const message = latest ? JSON.parse(latest.data) : null;
+    const metadata: ConversationMetadata = { model: message?.modelID ?? null, reasoning_effort: message?.variant ?? null };
+    const first = rows[0]?.id;
+    const cursor = first && db.query("SELECT id FROM message WHERE session_id = ? AND id < ? LIMIT 1").get(sessionId, first) ? cursorFor(first) : null;
+    const answer = { source: "opencode-transcript" as const, turns, metadata, cursor, history_id: historyId };
+    return { ...answer, version: createHash("sha256").update(JSON.stringify(answer)).digest("base64url") };
+  });
+}
+
+export function openCodeToolOutput(sessionId: string, ref: string, path = defaultOpenCodeDatabase()): string | null {
+  return readDatabase(path, db => {
+    const row = db.query("SELECT data FROM part WHERE session_id = ? AND id = ?").get(sessionId, ref) as { data: string } | null;
+    const part = row ? JSON.parse(row.data) : null;
+    return part?.type === "tool" ? String(part.state?.output ?? part.state?.error ?? "").slice(0, 2_000_000) : null;
+  });
+}
