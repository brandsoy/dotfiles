+import { expect, test } from "bun:test";
+import { createHash } from "node:crypto";
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { createServer } from "./index.ts";
+import { herdrRpc, workspaceCreate, workspaceClose } from "./herdr/client.ts";
+
+test("Vibe conversation HTTP contract follows the pane's open lease", async () => {
+  const root = mkdtempSync(join(tmpdir(), "herdr-vibe-contract-"));
+  const prior = process.env["VIBE_HOME"];
+  const id = "21f11251-8d05-45e1-dbcc-5dfb76900e28", gen = "0000000000000001";
+  const store = join(root, "logs", "session"), session = join(store, "unified", id);
+  for (const dir of [join(store, "active"), join(session, "chunks"), join(session, `generations/${gen}`), join(session, "journal")]) mkdirSync(dir, { recursive: true });
+  const hash = (text: string) => createHash("sha256").update(text).digest("hex");
+  const chunk = JSON.stringify([{ id: "hello", sessionId: id, type: "message", role: "user", content: [{ type: "text", text: "hello Vibe" }], createdAt: 1000, updatedAt: 1000 }]);
+  writeFileSync(join(session, "chunks", `${hash(chunk)}.json`), `${chunk}\n`);
+  const projection = JSON.stringify({ snapshot: { session: {} } });
+  writeFileSync(join(session, `generations/${gen}/projection-state.json`), projection);
+  const manifest = JSON.stringify({ session_id: id, projection_state: { chunks: [hash(chunk)], sha256: hash(projection) }, recovery_journal_segment: { path: "journal/0000000000000002.jsonl" } });
+  writeFileSync(join(session, `generations/${gen}/manifest.json`), manifest);
+  writeFileSync(join(session, "CURRENT"), JSON.stringify({ session_id: id, generation: gen, manifest_sha256: hash(manifest), snapshot_sequence: 1, store_format: "mistral.vibe.unified-session-store/v1" }));
+  writeFileSync(join(session, "journal/0000000000000002.jsonl"), "");
+  const lock = join(store, "active", `${id}.lock`);
+  const fixture = join(root, "fixture.cjs");
+  writeFileSync(fixture, `const fs = require('node:fs'); const fd = fs.openSync(${JSON.stringify(lock)}, 'w');
+    fs.writeFileSync(${JSON.stringify(`${lock}.json`)}, JSON.stringify({process_id: process.pid, session_id: ${JSON.stringify(id)}}));
+    setInterval(() => fs.fstatSync(fd), 1000);`);
+  const created = await herdrRpc<Awaited<ReturnType<typeof workspaceCreate>>>("workspace.create", { label: "herdr-web-ui-test-vibe", cwd: root, focus: false });
+  let app: ReturnType<typeof createServer> | undefined;
+  try {
+    process.env["VIBE_HOME"] = root;
+    await herdrRpc("pane.send_text", { pane_id: created.root_pane.pane_id, text: `bash -c 'exec -a vibe node ${fixture}'\r` });
+    const deadline = Date.now() + 5000;
+    while (true) {
+      await herdrRpc("pane.report_agent", { pane_id: created.root_pane.pane_id, source: "manual", agent: "vibe", state: "idle" });
+      const info = await herdrRpc<{ agent: { agent?: string } }>("agent.get", { target: created.root_pane.pane_id }).catch(() => null);
+      if (info?.agent.agent === "vibe") break;
+      if (Date.now() >= deadline) throw new Error("test Vibe process was not detected");
+      await Bun.sleep(50);
+    }
+    app = createServer({ port: 0, stateDir: join(root, "state") });
+    const url = `http://localhost:${app.port}/api/pane/conversation?pane_id=${created.root_pane.pane_id}`;
+    // The fixture process needs a moment to open the lock file after the pane starts it.
+    let body: Record<string, unknown> | undefined;
+    let etag: string | null = null;
+    const fetchDeadline = Date.now() + 5000;
+    while (true) {
+      const res = await fetch(url);
+      body = await res.json() as Record<string, unknown>;
+      etag = res.headers.get("etag");
+      if (body["source"] === "vibe-transcript") break;
+      if (Date.now() >= fetchDeadline) break;
+      await Bun.sleep(100);
+    }
+    expect(body).toMatchObject({ source: "vibe-transcript", turns: [{ role: "user", parts: [{ kind: "text", text: "hello Vibe" }] }], cursor: null });
+    expect((await fetch(url, { headers: { "if-none-match": etag! } })).status).toBe(304);
+    expect((await fetch(`${url}&before=wrong-session:hello`)).status).toBe(409);
+  } finally {
+    app?.stop();
+    if (prior === undefined) delete process.env["VIBE_HOME"]; else process.env["VIBE_HOME"] = prior;
+    await workspaceClose(created.workspace.workspace_id);
+    rmSync(root, { recursive: true, force: true });
+  }
+}, 15_000);
