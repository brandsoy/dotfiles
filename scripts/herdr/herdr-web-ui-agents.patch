+import { expect, test } from "bun:test";
+import { Database } from "bun:sqlite";
+import { mkdirSync, mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { createServer } from "./index.ts";
+import { paneConversation } from "./conversation.ts";
+import { herdrRpc, workspaceCreate, workspaceClose } from "./herdr/client.ts";
+
+// The test harness selects an isolated herdr session, never the user's session.
+test("OpenCode conversation HTTP contract, ETag, and stale cursor", async () => {
+  const root = mkdtempSync(join(tmpdir(), "herdr-opencode-contract-"));
+  const prior = process.env["XDG_DATA_HOME"];
+  mkdirSync(join(root, "opencode"));
+  const db = new Database(join(root, "opencode", "opencode.db"));
+  db.exec(`CREATE TABLE session (id TEXT PRIMARY KEY, revert TEXT);
+    CREATE TABLE message (id TEXT PRIMARY KEY, session_id TEXT, time_created INTEGER, data TEXT);
+    CREATE TABLE part (id TEXT PRIMARY KEY, session_id TEXT, message_id TEXT, data TEXT);
+    INSERT INTO session VALUES ('ses_contract', NULL);
+    INSERT INTO message VALUES ('msg_1', 'ses_contract', 1000, '{"role":"user"}');
+    INSERT INTO part VALUES ('prt_1', 'ses_contract', 'msg_1', '{"type":"text","text":"hello OpenCode"}');`);
+  db.close();
+  const created = await herdrRpc<Awaited<ReturnType<typeof workspaceCreate>>>("workspace.create", { label: "herdr-web-ui-test-opencode", cwd: root, focus: false });
+  let app: ReturnType<typeof createServer> | undefined;
+  try {
+    process.env["XDG_DATA_HOME"] = root;
+    await herdrRpc("pane.send_text", { pane_id: created.root_pane.pane_id, text: `bash -c 'exec -a opencode node -e "setInterval(()=>{},1000)" -- --session ses_contract'\r` });
+    const deadline = Date.now() + 5000;
+    while (true) {
+      const info = await herdrRpc<{ agent: { agent?: string } }>("agent.get", { target: created.root_pane.pane_id }).catch(() => null);
+      if (info?.agent.agent === "opencode") break;
+      if (Date.now() >= deadline) throw new Error("test OpenCode process was not detected");
+      await Bun.sleep(50);
+    }
+    await herdrRpc("pane.report_agent_session", { pane_id: created.root_pane.pane_id,
+      source: "herdr:opencode", agent: "opencode", agent_session_id: "ses_contract", session_start_source: "select" });
+
+    expect((await paneConversation(created.root_pane.pane_id)).source).toBe("opencode-transcript");
+    app = createServer({ port: 0, stateDir: join(root, "state") });
+    const url = `http://localhost:${app.port}/api/pane/conversation?pane_id=${created.root_pane.pane_id}`;
+    const response = await fetch(url);
+    expect(response.status).toBe(200);
+    expect(await response.json()).toMatchObject({ source: "opencode-transcript", turns: [{ role: "user", parts: [{ kind: "text", text: "hello OpenCode" }] }], cursor: null });
+    expect((await fetch(url, { headers: { "if-none-match": response.headers.get("etag")! } })).status).toBe(304);
+    expect((await fetch(`${url}&before=wrong-session:msg_1`)).status).toBe(409);
+  } finally {
+    app?.stop();
+    if (prior === undefined) delete process.env["XDG_DATA_HOME"]; else process.env["XDG_DATA_HOME"] = prior;
+    await workspaceClose(created.workspace.workspace_id);
+    rmSync(root, { recursive: true, force: true });
+  }
+}, 15_000);
