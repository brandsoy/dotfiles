new file mode 100644
index 00000000..7a8cbe0b
--- /dev/null
+++ b/server/adapters.ts
@@ -0,0 +1,48 @@
+/**
+ * Out-of-tree agent adapters: modules under $HERDR_WEB_UI_AGENTS_DIR
+ * (default ~/.config/herdr-web-ui/agents)/<agent>.ts, each exporting
+ * adapter(ctx). They are deployed separately from the plugin and survive its
+ * updates; only this loader and the routing hooks in conversation.ts are
+ * patched in-tree (scripts/herdr/herdr-web-ui/hook.patch in the dotfiles).
+ */
+import { existsSync } from "node:fs";
+import { homedir } from "node:os";
+import { join } from "node:path";
+import { ConversationUnavailable, HistoryChanged, type ConversationPage, type RecognizedConversation } from "./conversation-shared.ts";
+import { herdrRpc, herdrSocketPath } from "./herdr/client.ts";
+import { trimOutput } from "./tool-output.ts";
+
+/** The plugin pieces an adapter may use: its own classes, so its route recognizes what adapters throw. */
+export interface AdapterContext {
+  herdrRpc: typeof herdrRpc;
+  herdrSocketPath: () => string;
+  trimOutput: typeof trimOutput;
+  ConversationUnavailable: typeof ConversationUnavailable;
+  HistoryChanged: typeof HistoryChanged;
+}
+
+/** An out-of-tree agent: a whole conversation of its own, or a transcript the pi reader parses. */
+export interface AgentAdapter {
+  conversation?: (paneId: string, page: ConversationPage) => Promise<RecognizedConversation> | RecognizedConversation;
+  /** the pane's transcript file, parsed as a pi session (PiG rides pi's reader) */
+  transcript?: (paneId: string) => Promise<string | null>;
+  toolOutput?: (paneId: string, ref: string) => Promise<string | null>;
+}
+
+const context: AdapterContext = { herdrRpc, herdrSocketPath, trimOutput, ConversationUnavailable, HistoryChanged };
+const loaded = new Map<string, AgentAdapter | null>();
+
+export async function agentAdapter(agent: string | null | undefined): Promise<AgentAdapter | null> {
+  if (!agent || !/^[a-z][a-z0-9]{0,31}$/.test(agent)) return null;
+  if (loaded.has(agent)) return loaded.get(agent) ?? null;
+  let adapter: AgentAdapter | null = null;
+  const dir = process.env["HERDR_WEB_UI_AGENTS_DIR"] ?? join(process.env["XDG_CONFIG_HOME"] || join(homedir(), ".config"), "herdr-web-ui", "agents");
+  try {
+    const file = join(dir, `${agent}.ts`);
+    if (existsSync(file)) adapter = (await import(file)).adapter?.(context) ?? null;
+  } catch (error) {
+    console.error(`herdr-web-ui: agent adapter "${agent}" failed to load:`, error);
+  }
+  loaded.set(agent, adapter);
+  return adapter;
+}
